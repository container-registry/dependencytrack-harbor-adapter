# Shared tool and base-image version pins - single source of truth.
# Loaded by Taskfile.yml via `dotenv` and consumed by CI workflows and Renovate.
#
# NOTE: dotenv exports every one of these into each task's environment. Names are
# deliberately build/tool-scoped (never a bare WAYBILL_* that the waybill CLI would
# read, and never a SCANNER_* that the adapter reads). Hence WAYBILL_CLI_* rather
# than a bare WAYBILL_VERSION.

# --- waybill CLI (pre-1.0 alpha: exact pin; breaking changes between alphas) ---
# Fetched by `task build:waybill` from the public release tarballs at
# github.com/kusari-oss/waybill (the project was renamed from mikebom; releases up
# to v0.1.0-alpha.65 ship mikebom-* asset names, alpha.66 onwards waybill-*) and
# staged into bin/linux-<arch>/ for the Dockerfile to COPY.
#
# alpha.69 is the floor, not just the latest: milestone 182 (--insecure-registry,
# --registry-ca-cert, --insecure-tls-skip-verify) is what lets waybill pull from a
# Harbor registry itself. Downgrading below it breaks every plain-HTTP and
# private-CA deployment. See docs/upstream-issues.md.
#
# We deliberately do NOT use ghcr.io/kusari-oss/waybill: that container package is
# private, so CI cannot pull it. The tarball binary is byte-identical to the one in
# the image. Switch back to a digest-pinned FROM once the package is public or
# mirrored into 8gcr.
#
# Both checksums are from the release's own SHA256SUMS and verified at fetch time.
# renovate: datasource=github-releases depName=kusari-oss/waybill
WAYBILL_CLI_VERSION=v0.1.0-alpha.69
# Not maintained by Renovate: a version bump PR leaves these pointing at the
# previous release. Regenerate with `task waybill:checksums` and commit.
WAYBILL_CLI_SHA256_LINUX_AMD64=47840e9dbb4579d4b849c7599c9cb2d9cb928d4a6c6c7e01ba89c79b424e4d56
WAYBILL_CLI_SHA256_LINUX_ARM64=59dcf8818767ed7542c2c3d440a6e36d48fb753ffbf30ddd1666ce266453217a

# --- Final image base (glibc is mandatory: waybill is *-unknown-linux-gnu) ---
# renovate: datasource=docker depName=gcr.io/distroless/cc-debian12 versioning=loose
DISTROLESS_BASE_IMAGE_TAG=nonroot
DISTROLESS_IMAGE_DIGEST=sha256:ce0d66bc0f64aae46e6a03add867b07f42cc7b8799c949c2e898057b7f75a151

# --- lprobe: distroless-friendly HTTP healthcheck binary bundled in the image ---
# https://github.com/fivexl/lprobe (no shell in distroless, so probes need a binary).
# Checksums from the release checksums.txt; verified by `task build:lprobe`.
# renovate: datasource=github-releases depName=fivexl/lprobe
LPROBE_VERSION=v0.1.9
LPROBE_SHA256_LINUX_AMD64=b8d99d11b92264a36be2d19a8c7048d6ec797d4820d3672f5e1bb82f625d94a8
LPROBE_SHA256_LINUX_ARM64=7ec9d0bdae8eda0675517c01a2ee0f1c09f629bf8f7031134b1d6ffc45977413

# --- Lint and security tooling ---
# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCILINT_VERSION=v2.8.0
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.4.0
# renovate: datasource=github-releases depName=crate-ci/typos
TYPOS_VERSION=1.44.0
# crate-ci/typos publishes no checksums; our own pin of the
# x86_64-unknown-linux-musl release asset. Recompute when bumping TYPOS_VERSION.
TYPOS_SHA256_LINUX_X86_64=1b788b7d764e2f20fe089487428a3944ed218d1fb6fcd8eac4230b5893a38779
# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.35.1

# --- Task version installed by CI (local installs may differ) ---
# renovate: datasource=github-releases depName=go-task/task
TASK_VERSION=3.49.1

# Go toolchain is intentionally NOT pinned here: go.mod's `go`/`toolchain`
# directives are authoritative, and CI uses actions/setup-go with go-version-file.
